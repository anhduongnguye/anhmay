{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/bai-viet/:id",
      "destination": "/bai-viet/:id/index.html"
    },
    {
      "source": "(.*)",
      "destination": "/index.html"
    }
  ]
}
